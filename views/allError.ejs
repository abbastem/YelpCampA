<%- layout('layouts/boilerplate')%>

<div class="row">
    <div class="col-6 offset-3 alert alert-danger" role="alert">
        <% if (!err.statusCode) {%>
            <h2>ERROR 404</h2>
        <% } else { %>
            <h2>ERROR <%= err.statusCode %></h2>
         <% }%>
        <hr>
        <h4 class="alert-heading"><%= err.message%></h4>
    </div>
</div>
