<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <link href="/bootstrapStyle/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/public/stylesheets/home.css">
    <title>YelpCamp</title>
</head>

<body class="d-flex text-center text-white bg-dark">
<div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
    <header class="mb-auto">
        <div>
            <h3 class="float-md-start mb-0">YelpCamp</h3>
            <nav class="nav justify-content-center float-md-end">
                <a class="nav-link active" aria-current="page" href="#">Home</a>
                <a class="nav-link" href="/campgrounds">Campgrounds</a>
                <% if(!currentUser) { %>
                    <a class="nav-link" href="/login">Login</a>
                    <a class="nav-link" href="/register">Register</a>
                <% } else { %>
                    <a class="nav-link" href="/logout">Logout</a>
                <% } %>
            </nav>
        </div>
    </header>
    <main class="px-3">
        <h1>YelpCamp</h1>
        <p class="lead"> Welcome to YelpCamp! <br> Jump right in and explore our many campgrounds. <br>
            Feel free to share some of your own and comment on others!</p>
        <a href="/campgrounds" class="btn btn-lg btn-secondary fw-bold border-white bg-white">View
            Campgrounds</a>
    </main>

    <footer class="mt-auto text-white-50">
        <p>&copy; 2025 By Abbas Asad</p>
    </footer>
</div>

<script src="/bootstrapStyle/js/bootstrap.bundle.min.js"></script>

</body>
</html>